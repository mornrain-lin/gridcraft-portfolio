{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1320px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": true,
			"customDuotone": false,
			"palette": [
				{
					"slug": "background",
					"color": "#ffffff",
					"name": "背景"
				},
				{
					"slug": "surface",
					"color": "#f6f6f7",
					"name": "浅底"
				},
				{
					"slug": "dark",
					"color": "#0f1013",
					"name": "深色区"
				},
				{
					"slug": "text",
					"color": "#16171a",
					"name": "正文"
				},
				{
					"slug": "text-soft",
					"color": "#55575e",
					"name": "次要文字"
				},
				{
					"slug": "muted",
					"color": "#8a8c93",
					"name": "弱化文字"
				},
				{
					"slug": "border",
					"color": "#e7e7ea",
					"name": "线条"
				},
				{
					"slug": "accent",
					"color": "#ff5a36",
					"name": "强调色"
				}
			]
		},
		"typography": {
			"customFontSize": true,
			"lineHeight": true,
			"dropCap": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "无衬线",
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"Helvetica Neue\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", \"Source Han Sans SC\", sans-serif"
				},
				{
					"slug": "mono",
					"name": "等宽",
					"fontFamily": "ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", \"Courier New\", monospace"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.875rem",
					"name": "小"
				},
				{
					"slug": "medium",
					"size": "1rem",
					"name": "中"
				},
				{
					"slug": "large",
					"size": "1.25rem",
					"name": "大"
				},
				{
					"slug": "x-large",
					"size": "1.5rem",
					"name": "特大"
				}
			]
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"blockGap": true,
			"units": [ "px", "em", "rem", "%", "vw", "vh" ]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "1rem",
			"lineHeight": "1.7"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--text)"
					}
				}
			},
			"h1": {
				"typography": {
					"fontSize": "3.6rem",
					"lineHeight": "1.2",
					"fontWeight": "700"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "2.4rem",
					"lineHeight": "1.2",
					"fontWeight": "700"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "1.25rem",
					"lineHeight": "1.3",
					"fontWeight": "700"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "1.05rem",
					"lineHeight": "1.4",
					"fontWeight": "700"
				}
			},
			"blockquote": {
				"color": {
					"text": "var(--wp--preset--color--text-soft)"
				},
				"border": {
					"left": {
						"color": "var(--wp--preset--color--accent)",
						"style": "solid",
						"width": "3px"
					}
				}
			},
			"code": {
				"color": {
					"background": "var(--wp--preset--color--surface)",
					"text": "var(--wp--preset--color--text)"
				},
				"border": {
					"color": "var(--wp--preset--color--border)",
					"style": "solid",
					"width": "1px"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "0.875em"
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--muted)"
				},
				"typography": {
					"fontSize": "0.8125rem"
				}
			}
		},
		"blocks": {
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--accent)",
						"style": "solid",
						"width": "3px"
					}
				}
			},
			"core/code": {
				"color": {
					"background": "var(--wp--preset--color--surface)",
					"text": "var(--wp--preset--color--text)"
				},
				"border": {
					"color": "var(--wp--preset--color--border)",
					"radius": "6px",
					"style": "solid",
					"width": "1px"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "0.875em",
					"lineHeight": "1.7"
				},
				"spacing": {
					"padding": "20px"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--border)"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "页头",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "页脚",
			"area": "footer"
		}
	]
}
